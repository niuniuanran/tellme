{
  "name": "Tell Me",
  "description": "This extension answers questions to selected text using AI",
  "version": "1.0",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel",  "contextMenus", "storage"],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  }
}